# ==============================================================================
# Scout Web (Next.js) — environment variables
# Copy to .env.local and fill in. NEXT_PUBLIC_* vars are exposed to the browser;
# everything else is server-only (route handlers / server actions). Never commit real
# values.
# ==============================================================================

# ------------------------------------------------------------------------------
# Auth — Clerk
# ------------------------------------------------------------------------------
# Publishable key (browser). Clerk Dashboard → API Keys → Publishable key.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Secret key (server). Clerk Dashboard → API Keys → Secret key.
CLERK_SECRET_KEY=
# Webhook signing secret. Clerk Dashboard → Webhooks → your endpoint → Signing secret.
CLERK_WEBHOOK_SECRET=
# Auth route URLs. Sign-up routes new users to /onboarding, sign-in to /dashboard.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# ------------------------------------------------------------------------------
# Database — Supabase
# ------------------------------------------------------------------------------
# Project URL + anon key (browser, RLS applies). Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (server only — bypasses RLS). Same value as the API's
# SUPABASE_SERVICE_ROLE_KEY. Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# Payments — Stripe
# ------------------------------------------------------------------------------
# Publishable key for Checkout in the browser. Developers → API keys → Publishable.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ------------------------------------------------------------------------------
# App / API config
# ------------------------------------------------------------------------------
# Base URL of the Scout FastAPI backend (no trailing slash). Blank ⇒ http://localhost:8000.
NEXT_PUBLIC_API_URL=
# Shared secret for Next.js → FastAPI internal proxy calls. Must match the API's
# SCOUT_INTERNAL_API_SECRET. Generate a long random string.
SCOUT_INTERNAL_API_SECRET=
# Base URL for NCAA logos on the landing marquee (no trailing slash).
# Defaults to https://ncaa-api.henrygd.me — self-host: github.com/henrygd/ncaa-api
NCAA_API_URL=

# ------------------------------------------------------------------------------
# Product analytics — PostHog (Epic 11.6)
# ------------------------------------------------------------------------------
# Project API key (browser) + host. PostHog → Project Settings → Project API Key.
# LEAVE BLANK locally — analytics no-ops cleanly when unset. Host defaults to
# https://us.i.posthog.com (use https://eu.i.posthog.com for EU projects).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ------------------------------------------------------------------------------
# Error monitoring — Sentry (Epic 11.5)
# ------------------------------------------------------------------------------
# Public DSN (browser + server). Sentry → Project → Settings → Client Keys (DSN).
# LEAVE BLANK locally — Sentry no-ops when unset. Set in Vercel for deploy.
NEXT_PUBLIC_SENTRY_DSN=
# Tags events; set to "production" in Vercel.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Performance trace sampling (0.0–1.0). Keep low. Default 0.1.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Build-time ONLY (Vercel) — uploads source maps. Optional; leave unset locally.
# Sentry → Settings → Auth Tokens. Pair with your org/project slugs.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
