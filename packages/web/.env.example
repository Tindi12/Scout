# Public key for Clerk in the browser. Copy from Clerk Dashboard → API Keys → Publishable key.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Server-side Clerk secret. Copy from Clerk Dashboard → API Keys → Secret key.
CLERK_SECRET_KEY=

# Signing secret for Clerk webhooks. Copy from Clerk Dashboard → Webhooks → your endpoint → Signing secret.
CLERK_WEBHOOK_SECRET=

# Supabase project URL. Copy from Supabase Dashboard → Project Settings → API → Project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous key (public, RLS applies). Copy from Supabase Dashboard → Project Settings → API → anon public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe publishable key for Checkout in the browser. Copy from Stripe Dashboard → Developers → API keys → Publishable key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Base URL of the Scout FastAPI backend (e.g. your Railway deployment). Used by the web app to call the API.
NEXT_PUBLIC_API_URL=
