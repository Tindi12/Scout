# Public key for Clerk in the browser. Copy from Clerk Dashboard → API Keys → Publishable key.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Server-side Clerk secret. Copy from Clerk Dashboard → API Keys → Secret key.
CLERK_SECRET_KEY=

# Signing secret for Clerk webhooks. Copy from Clerk Dashboard → Webhooks → your endpoint → Signing secret.
CLERK_WEBHOOK_SECRET=

# Clerk auth route URLs. The middleware redirects unauthenticated users to /sign-in,
# and Clerk's hosted components route users to /onboarding after a fresh sign-up
# and /dashboard after a returning sign-in.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Supabase project URL. Copy from Supabase Dashboard → Project Settings → API → Project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous key (public, RLS applies). Copy from Supabase Dashboard → Project Settings → API → anon public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (server only — Next.js route handlers / server actions). Same as SUPABASE_SERVICE_ROLE_KEY in packages/api/.env.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe publishable key for Checkout in the browser. Copy from Stripe Dashboard → Developers → API keys → Publishable key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Base URL of the Scout FastAPI backend (no trailing slash), e.g. http://127.0.0.1:8000 or your Railway URL.
# Leave unset or blank for local dev defaults to http://localhost:8000. Do not set to empty string alone — that breaks browser fetch.
NEXT_PUBLIC_API_URL=

# Shared secret for the Next.js route /api/resume/analyze → FastAPI. Generate a long random string and set the
# same variable in packages/api/.env so the proxy can authenticate server-to-server (no Clerk Supabase JWT template required in the browser).
SCOUT_INTERNAL_API_SECRET=

# Base URL for NCAA logos on the landing page marquee (no trailing slash).
# Defaults to the public demo API: https://ncaa-api.henrygd.me
# Self-host: https://github.com/henrygd/ncaa-api
NCAA_API_URL=
